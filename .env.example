# Copy this file to `.env` and fill in values. `.env` is gitignored.

# Azure Maps Web SDK subscription key (used by the browser via /api/config).
AZURE_MAPS_KEY=

# Port for the local server.
PORT=3000

# Where the server reads the GeoJSON from: "onelake" (direct file read) or "udf".
DATA_SOURCE=onelake

# Lakehouse coordinates (defaults point at the shared MSIT lakehouse).
WORKSPACE_ID=61077f32-d21a-4791-b383-cacbddf222f5
LAKEHOUSE_ID=b97fcfa2-6e58-4898-ab81-00ed5d1396cb
FILE_PATH=Files/GeoJson/Car_Parks.geojson

# --- Only needed when DATA_SOURCE=udf ---
# Full invocation URL of the published Fabric User Data Function.
UDF_ENDPOINT=
# Entra resource/audience to request a token for when calling the UDF.
UDF_RESOURCE=https://analysis.windows.net/powerbi/api
# JSON body sent to the function (parameters), e.g. {"filePath":"Files/GeoJson/Car_Parks.geojson"}
UDF_BODY={}
