# Optional local overrides for config/constants.js. Copy this file to .env.
PORT=3000

# Identity configuration for local service-principal authentication or a user-assigned managed identity.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# Azure Maps uses this key only for local development; hosted deployments use the client id and managed identity.
AZURE_MAPS_KEY=
AZURE_MAPS_CLIENT_ID=

# Published Fabric User Data Function audience and endpoint overrides.
UDF_RESOURCE=
UDF_CARPARK_ENDPOINT=
UDF_PMTILES_ENDPOINT=
UDF_AIRPORTS_ENDPOINT=
UDF_EVENTSTREAM_ENDPOINT=
