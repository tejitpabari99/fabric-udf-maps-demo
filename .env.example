# Almost all config now lives in config/constants.js (one file, no secrets).
# This .env is OPTIONAL — only for LOCAL overrides. Copy to `.env` (gitignored).

# Azure Maps subscription key — LOCAL dev fallback only. When set, the browser uses
# the key; when empty, it uses Entra token auth (/api/maps-token). Leave empty for
# the hosted app so the key is never exposed.
AZURE_MAPS_KEY=

PORT=3000

# ---- Identity (how the proxy authenticates) — see docs/managed-identity-setup.md ----
# Local without `az login`: set a service principal (EnvironmentCredential).
# In Azure: leave blank and use the managed identity.
# Otherwise DefaultAzureCredential falls back to `az login`.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# ---- Optional overrides of config/constants.js values ----
# (Only set these to override the constants file without editing it.)
# AZURE_MAPS_CLIENT_ID=
# WORKSPACE_ID=
# LAKEHOUSE_ID=
# SQL_ENDPOINT=
# SQL_DATABASE=
# EVENTSTREAM_KUSTO_URI=
# EVENTSTREAM_KUSTO_DB=
# EVENTSTREAM_TABLE=
# UDF_RESOURCE=
# UDF_CARPARK_ENDPOINT=
# UDF_PMTILES_ENDPOINT=
# UDF_AIRPORTS_ENDPOINT=
# UDF_EVENTSTREAM_ENDPOINT=
