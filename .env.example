# Copy this file to `.env` and fill in values. `.env` is gitignored.

# ---- Secrets / local config ----
# Azure Maps Web SDK subscription key (used by the browser via /api/config).
AZURE_MAPS_KEY=
PORT=3000

# ---- Identity (how the proxy authenticates to Fabric) ----
# The proxy uses @azure/identity DefaultAzureCredential. Options:
#  - Local, no `az login`: set a service principal below (EnvironmentCredential).
#  - In Azure: leave blank and use a managed identity (optionally pin a
#    user-assigned one with AZURE_MANAGED_IDENTITY_CLIENT_ID).
#  - Developer fallback: just `az login`.
# See docs/managed-identity-setup.md.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# ---- Lakehouse (defaults point at the shared MSIT lakehouse) ----
WORKSPACE_ID=61077f32-d21a-4791-b383-cacbddf222f5
LAKEHOUSE_ID=b97fcfa2-6e58-4898-ab81-00ed5d1396cb

# ---- Fabric SQL analytics endpoint (airports table) ----
SQL_ENDPOINT=x6eps4xrq2xudenlfv6naeo3i4-gj7qoyi22kiupm4dzlf534rc6u.msit-datawarehouse.fabric.microsoft.com
SQL_DATABASE=TejitLH

# ---- Fabric Eventhouse / Kusto (tejit-kusto) ----
KUSTO_URI=https://trd-tne4bs58upcvrph9ak.z1.kusto.fabric.microsoft.com
KUSTO_DB=TejitEH

# ---- Eventstream (Bicycle-eventstream / SampleES) ----
EVENTSTREAM_ID=a08bed4d-242a-4676-be4e-a1d62ae4cd6d
EVENTSTREAM_NAME=SampleES
EVENTSTREAM_KUSTO_URI=https://trd-tne4bs58upcvrph9ak.z1.kusto.fabric.microsoft.com
EVENTSTREAM_KUSTO_DB=TejitEH
EVENTSTREAM_TABLE=

# ---- UDF invocation (Entra audience shared across all UDFs) ----
UDF_RESOURCE=https://analysis.windows.net/powerbi/api

# ---- Per-source published UDF invocation URLs (fill in after publishing) ----
UDF_CARPARK_ENDPOINT=
UDF_PMTILES_ENDPOINT=
UDF_AIRPORTS_ENDPOINT=
UDF_KUSTO_ENDPOINT=
UDF_EVENTSTREAM_ENDPOINT=
